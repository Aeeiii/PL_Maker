<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorPrimaryVariant"
    android:orientation="vertical"
    tools:context=".ui.tracklist.SearchActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/my_toolbar"
        style="@style/ToolbarStyle"
        app:title="@string/search" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginHorizontal="@dimen/regular_margin"
        android:layout_marginTop="8dp"
        android:background="@drawable/shape">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="12dp"
            android:src="@drawable/search"
            app:tint="?attr/colorOnSurface">

        </ImageView>


        <EditText
            android:id="@+id/search"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:autofillHints="true"
            android:background="@null"
            android:cursorVisible="true"
            android:hint="@string/search"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:maxLines="1"
            android:singleLine="true"
            android:textColor="@color/black"
            android:textColorHint="?attr/colorOnSurface"
            android:textCursorDrawable="@drawable/cursor"
            tools:ignore="labelFor" />

        <ImageView
            android:id="@+id/clean_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="12dp"
            android:src="@drawable/clean"
            android:visibility="gone"
            app:tint="?attr/colorOnSurface"
            tools:visibility="visible">

        </ImageView>

    </LinearLayout>

    <ProgressBar android:id="@+id/progressBar"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="140dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/background"
        android:visibility="gone"
        tools:visibility="visible"/>

    <include
        layout="@layout/error_layout"
        tools:visibility="gone" />


    <TextView
        android:id="@+id/hint_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="42dp"
        android:fontFamily="@font/ys_display_medium"
        android:text="@string/saved_tracks"
        android:textColor="?attr/colorError"
        android:textSize="@dimen/error_text_size"
        android:visibility="gone">

    </TextView>

    <include layout="@layout/track_list" />




</LinearLayout>